# Django Configuration
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database Configuration
# Options: sqlite3, postgresql
DB_ENGINE=sqlite3

# SQLite Configuration (used when DB_ENGINE=sqlite3)
DB_PATH=/code/data/db.sqlite3

# PostgreSQL Configuration (used when DB_ENGINE=postgresql)
DB_NAME=checkoutdb
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Admin User (created automatically on first run)
# Default: username=admin, password=admin123
# You can modify this in entrypoint.sh
